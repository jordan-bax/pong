{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "outDir": "./dist",
        "rootDir": "./",
        "rewriteRelativeImportExtensions": true,
        "erasableSyntaxOnly": true,
        "typeRoots": ["node_modules/@types"],
        "moduleResolution": "NodeNext",
    },
    "include": ["./src", "./db", "./schemas/"]
}
