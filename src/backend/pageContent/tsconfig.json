{
    "compilerOptions": {
        "target": "ES2024",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "typeRoots": ["./types", "node_modules/@types"],
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "baseUrl": "./",
        "paths": {
            "@transcendanse/shared-types": ["./shared/types"]
        }
    },
    "include": ["./*.ts", "./db", "./shared/types/**/*.d.ts"]
}