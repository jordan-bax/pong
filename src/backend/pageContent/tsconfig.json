{
    "compilerOptions": {
        "target": "ES2024",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "typeRoots": ["./types", "node_modules/@types"],
        "noImplicitAny": true,
        "noImplicitReturns": true
    },
    "include": ["./types", "./*.ts", "./db"]
}