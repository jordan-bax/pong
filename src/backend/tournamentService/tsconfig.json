{
  "compilerOptions": {
     // "noEmit": true, // Optional - see note below
     "target": "esnext",
     "module": "nodenext",
    "outDir": "./dist",
    "rootDir": "./",
     "rewriteRelativeImportExtensions": true,
     "erasableSyntaxOnly": true,
     "verbatimModuleSyntax": true,
        "typeRoots": ["node_modules/@types"],
        "moduleResolution": "NodeNext",
  },
    "include": ["./*.ts", "./db", "./schemas/"]
}

