{
    "compilerOptions": {
        "target": "ES2024",
        "module": "CommonJS",
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "typeRoots": ["node_modules/@types"],
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "baseUrl": "./",
        "paths": {
            "@transcendanse/shared-types": ["./shared/types"]
        }
    },
    "include": [
        "./*.ts",
        "./schemas",
        "./db",
        "./shared/types/**/*.d.ts"]
}